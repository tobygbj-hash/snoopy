[Desktop Entry]
Type=Application
Name=Snoopy Kiosk
Comment=Voice agent and Google AI summary reader for Toby
Exec=/usr/bin/chromium-browser --kiosk --noerrdialogs --disable-infobars --load-extension=/home/pi/snoopy/extension --unsafely-treat-insecure-origin-as-secure=http://localhost:8000 http://localhost:8000/
X-GNOME-Autostart-enabled=true
